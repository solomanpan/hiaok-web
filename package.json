{
  "name": "hiaok-web",
  "private": true,
  "version": "1.0.0",
  "description": "Web / desktop / mobile console for the hiaok permission center (one React Native app: iOS, Android, web, and desktop through a Tauri 2 shell)",
  "license": "MIT",
  "workspaces": [
    "tests",
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @hiaok/tests",
    "build": "npm run build --workspaces --if-present",
    "web": "npm run web -w @hiaok/app",
    "ios": "npm run ios -w @hiaok/app",
    "android": "npm run android -w @hiaok/app",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
